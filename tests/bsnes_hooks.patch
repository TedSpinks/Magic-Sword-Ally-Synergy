@@ -785,12 +785,21 @@ RETRO_API unsigned retro_get_region()
 
 // Currently, there is no safe/sensible way to use the memory interface without severe hackery.
 // Rely on higan to load and save SRAM until there is really compelling reason not to.
+namespace SuperFamicom { unsigned* ms_ring_ptr(); unsigned ms_ring_pos(); void ms_cpu(unsigned*); void* ms_wram(); void* ms_sram(); unsigned ms_sram_size(); }
 RETRO_API void *retro_get_memory_data(unsigned id)
 {
+	if(id == RETRO_MEMORY_SYSTEM_RAM) return SuperFamicom::ms_wram();
+	if(id == RETRO_MEMORY_SAVE_RAM && SuperFamicom::ms_sram_size()) return SuperFamicom::ms_sram();
 	return nullptr;
 }
 
 RETRO_API size_t retro_get_memory_size(unsigned id)
 {
+	if(id == RETRO_MEMORY_SYSTEM_RAM) return 128 * 1024;
+	if(id == RETRO_MEMORY_SAVE_RAM) return SuperFamicom::ms_sram_size();
 	return 0;
 }
+
+extern "C" RETRO_API void ms_cpu(unsigned* o) { SuperFamicom::ms_cpu(o); }
+extern "C" RETRO_API unsigned* ms_ring() { return SuperFamicom::ms_ring_ptr(); }
+extern "C" RETRO_API unsigned ms_ringpos() { return SuperFamicom::ms_ring_pos(); }
