+    const char* q = e; unsigned lo, hi; int n;
+    while(sscanf(q, "%x-%x%n", &lo, &hi, &n) == 2) { for(unsigned i = lo; i < hi && i < sizeof(wram); i++) keep[i] = 1; q += n; if(*q == ',') q++; else break; }
